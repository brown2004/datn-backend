APP_PORT=8081
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/datn?sslmode=disable
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=datn

JWT_SECRET=my_local_dev_secret_very_long_32_chars_minimum
